[MDI_HEADER]
FILE_TYPE                = 'tir'
FILE_VERSION             = 3.0
FILE_FORMAT              = 'ASCII'
! A synthetic MF 5.2 test tyre for the tests of task 7.4, not a real tyre:
! the coefficients MF 5.2 shares with the 205/60R15 tyre of Pacejka, Tire and
! Vehicle Dynamics, 3rd ed. (2012), Appendix 3, Table A3.1, and MF 5.2's own
! (PHY3, PTX1 to PTX3, PTY1, PTY2), chosen for the test. MF 6.1's
! additions (inflation pressure, PKY4 to PKY7, PEY5, QSX4 and on, QSY5 and on,
! the carcass's stiffnesses) are left out. Scaling factors other than 1, also
! chosen for the test, but for the camber factors LGAX, LGAY and LGAZ, which
! MFeval does not take.
$-----------------------------------------------------------------------units
[UNITS]
LENGTH                   = 'meter'
FORCE                    = 'newton'
ANGLE                    = 'radians'
MASS                     = 'kg'
TIME                     = 'second'
$-----------------------------------------------------------------------model
[MODEL]
FITTYP                   = 6                 $ MF-Tyre 5.2
LONGVL                   = 16.7              $ Vo
VXLOW                    = 1                 $ Vx,low
$-------------------------------------------------------------------dimension
[DIMENSION]
UNLOADED_RADIUS          = 0.3135            $ ro
WIDTH                    = 0.205             $ w
RIM_RADIUS               = 0.1905            $ rrim
$--------------------------------------------------------operating_conditions
[OPERATING_CONDITIONS]
$--------------------------------------------------------------------vertical
[VERTICAL]
FNOMIN                   = 4000              $ Fzo
VERTICAL_STIFFNESS       = 209651            $ czo
VERTICAL_DAMPING         = 50                $ kz
Q_V2                     = 0.04667
Q_FZ2                    = 15.4
Q_FCX                    = 0
Q_FCY                    = 0
PFZ1                     = 0.7098
BREFF                    = 8.386
DREFF                    = 0.25826
FREFF                    = 0.07394
Q_RE0                    = 0.9974
Q_V1                     = 7.742e-4
$------------------------------------------------------------------structural
[STRUCTURAL]
$---------------------------------------------------------scaling_coefficients

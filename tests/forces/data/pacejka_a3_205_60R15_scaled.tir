[MDI_HEADER]
FILE_TYPE                = 'tir'
FILE_VERSION             = 3.0
FILE_FORMAT              = 'ASCII'
! The passenger car tyre 205/60R15 91 V of Pacejka, Tire and Vehicle Dynamics,
! 3rd ed. (2012), Appendix 3, Table A3.1, as in pacejka_a3_205_60R15.tir, with
! scaling factors other than 1, chosen for the tests of task 7.4: every factor
! MF 6.1 has but LMUV (friction falling with slip speed, which MFeval does not
! take) and LMP (turn slip, not modelled).
$-----------------------------------------------------------------------units
[UNITS]
LENGTH                   = 'meter'
FORCE                    = 'newton'
ANGLE                    = 'radians'
MASS                     = 'kg'
TIME                     = 'second'
$-----------------------------------------------------------------------model
[MODEL]
